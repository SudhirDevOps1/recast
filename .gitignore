# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Builds
dist/
out/
build/
release/
apps/desktop/dist/
packages/*/dist/
*.tsbuildinfo

# Electron
*.asar
*.asar.unpacked/
.electron/
.electron-builder-cache/
app-update.yml
latest*.yml
*.blockmap

